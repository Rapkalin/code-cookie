# ─────────────────────────────────────────────────────────────
# Configuration d'environnement — code-cookie
#
# En LOCAL, copier ce fichier en `.env` à la racine du dépôt :
#
#     cp .env.example .env
#
# Sur le SERVEUR, il vit dans `shared/.env` et est lié dans le docroot
# (`website/.env`). Les valeurs par défaut ci-dessous correspondent à
# l'environnement Docker fourni.
# ─────────────────────────────────────────────────────────────

# Environnement : development | staging | production
WP_ENV='development'

# ─────────────────────────────────────────────────────────────
# Ports publiés sur l'hôte (docker-compose.yml)
# Choisis libres sur le poste de Raphael : 8020/8021/8025 sont pris par LCDS,
# 3306 et 3307 par MySQL local et LCDS.
# ─────────────────────────────────────────────────────────────
APP_PORT='8030'
PMA_PORT='8031'
MAILPIT_PORT='8035'
DATABASE_PORT='3308'

# Version de PHP de l'image (argument de build).
# 8.3 tant que le cœur est en 6.7.1 — voir docker/php/Dockerfile.
PHP_VERSION='8.3'

# ─────────────────────────────────────────────────────────────
# URLs
# WP_HOME = URL publique du site, SANS slash final. Le cœur WordPress est servi
# depuis /wordpress-core et le contenu depuis /app : les deux en sont déduits,
# il n'y a donc qu'une seule valeur à changer.
# ─────────────────────────────────────────────────────────────
WP_HOME='http://localhost:8030'

# ─────────────────────────────────────────────────────────────
# Base de données (MySQL 8.4)
# DATABASE_HOST='db' = nom du service MySQL dans docker-compose.yml.
# Hors Docker, utiliser 'localhost'.
# ─────────────────────────────────────────────────────────────
DATABASE_NAME='codecookie'
DATABASE_USER='codecookie'
DATABASE_PASSWORD='codecookie'
DATABASE_HOST='db'
DATABASE_ROOT_PASSWORD='root'
# DATABASE_PREFIX='wp_'
# DATABASE_SSL='true'

# ─────────────────────────────────────────────────────────────
# Identifiants créés au TOUT PREMIER démarrage par bin/init.sh
# (`wp core install`). Sans effet ensuite, et ignorés si un dump est importé
# avant le premier lancement.
# ─────────────────────────────────────────────────────────────
WP_TITLE='Code Cookie'
WP_ADMIN_USER='admin'
WP_ADMIN_PASSWORD='admin'
WP_ADMIN_EMAIL='admin@code-cookie.local'

# ─────────────────────────────────────────────────────────────
# Cache pleine page (W3 Total Cache) — désactivé par défaut en local.
# Passer à 'true' définit la constante WP_CACHE ET active l'extension au
# démarrage. En local, la laisser à 'false' : le cache masque les modifications
# de code et sert des URLs de production issues du dump.
# ─────────────────────────────────────────────────────────────
WP_CACHE='false'

# WP-Cron : laisser 'false' en local (tâches déclenchées par le trafic).
# En PRODUCTION, passer à 'true' ET configurer un cron système, sinon les
# tâches planifiées ne tournent plus.
DISABLE_WP_CRON='false'

# ─────────────────────────────────────────────────────────────
# Clés et sels d'authentification — OBLIGATOIRES et UNIQUES par environnement.
# Laissés à 'generateme', ils sont générés au premier démarrage par
# bin/init.sh. En production, générer un jeu sur https://roots.io/salts.html
# Les changer invalide toutes les sessions ouvertes.
#
# ⚠️ Ils étaient auparavant EN DUR dans website/wp-config.php, aux valeurs
# d'exemple de WordPress. Le jeu de production est donc à régénérer.
# ─────────────────────────────────────────────────────────────
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# ─────────────────────────────────────────────────────────────
# Scripts d'import depuis la production (scripts/import-db.php,
# scripts/sync-uploads.php) — poste de dev uniquement.
# ─────────────────────────────────────────────────────────────
PROD_HOST=''
PROD_USER=''
PROD_SITEURL=''
DATABASE_PROD_HOST=''
DATABASE_PROD_NAME=''
DATABASE_PROD_USER=''
DATABASE_PROD_PASSWORD=''
